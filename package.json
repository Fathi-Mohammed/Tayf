{
  "name": "tayf",
  "productName": "Tayf",
  "version": "0.10.0",
  "description": "A keyboard-first overlay for your Jira work items — press a hotkey anywhere, act, and get back to what you were doing.",
  "main": "src/main/index.js",
  "license": "MIT",
  "author": "Fathy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fathi-Mohammed/Tayf.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/**/*.test.*\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-config": "node scripts/check-config.js",
    "probe-boards": "node scripts/probe-boards.js",
    "probe-worklogs": "node scripts/probe-worklogs.js",
    "make-icons": "node scripts/make-icons.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "try-nudge": "electron scripts/try-nudge.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/readex-pro": "^5.3.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4"
  }
}
